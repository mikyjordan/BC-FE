{
  "name": "@bustercinema/frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "webpack serve --mode development",
    "start:rete": "HOST=0.0.0.0 webpack serve --mode development",
    "build": "tsc -b && webpack --mode production",
    "pm2": "GENERATE_SOURCEMAP=false npm run build && pm2 start -spa 'serve -s build -p 3000' --name PGFE && pm2 log PGFE",
    "serve": "serve -s build -p 3000",
    "typecheck": "tsc -b",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "e2e": "playwright test",
    "lint": "oxlint"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.2",
    "@tanstack/react-query": "^5.105.3",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "react-router": "^8.5.1",
    "recharts": "^3.10.1",
    "styled-components": "^6.6.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "@babel/parser": "^7.29.12",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@jest/globals": "^30.5.2",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-jest": "^30.5.2",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "serve": "^14.2.7",
    "typescript": "~7.0.2",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1",
    "webpack-dev-server": "^6.1.0",
    "workbox-webpack-plugin": "^7.4.1"
  }
}
